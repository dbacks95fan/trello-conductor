# Trello API credentials
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_API_SECRET=

TRELLO_BOARD_ID=
# Defaults to the sibling agentic-sdlc repository's canonical lifecycle template.
# TRELLO_WORKFLOW_TEMPLATE=C:/Repos/agentic-sdlc/templates/trello-board-workflow.yaml

# ProductConfig 1.1 in intent-backlog maps each canonical stage to the Trello
# list ID for this board. The Orchestrator verifies those IDs against TRELLO_BOARD_ID.

WIP_LIMIT=1

# Absolute path to the built Coding Agent CLI entrypoint.
CODING_AGENT_CLI=C:/Repos/coding-agent/dist/cli.js

# The Spec & Design Agent runs as a one-shot Docker container on this host.
# Build and deploy the image separately, from the spec-design-agent repo:
#   docker compose build          (tags spec-design-agent:local)
# The orchestrator only runs it:
#   docker run --rm --mount type=bind,source=<workspace>,target=/work \
#     ... <image> spec --request /work/spec-design-request.json
SPEC_DESIGN_AGENT_IMAGE=spec-design-agent:local
SPEC_DESIGN_AGENT_PROVIDER=claude
# Optional local development override. Keep `auto` + `docker` for the ideal runtime.
# Set `manual` on the webhook runtime to avoid auto-starting; then run the CLI locally.
# SPEC_DESIGN_KICKOFF_MODE=manual
# SPEC_DESIGN_RUNTIME=local
# SPEC_DESIGN_AGENT_DIR=C:/Repos/spec-design-agent
# SPEC_DESIGN_UV=uv
# SPEC_DESIGN_AGENT_DOCKER=docker
# Hard kill for a run, in ms. Keep above the agent's own SPEC_AGENT_TIMEOUT_MS.
# SPEC_DESIGN_AGENT_TIMEOUT_MS=900000
# env-file handed to the container for provider credentials (ANTHROPIC_API_KEY).
# Defaults to C:/Repos/spec-design-agent/.runtime.env — keep it out of any repo.
# SPEC_DESIGN_AGENT_RUNTIME_ENV=C:/Repos/spec-design-agent/.runtime.env

# Frozen intent lookup. The canonical intent.md lives in the private
# intent-backlog repository; the orchestrator reads the exact pinned commit.
INTENT_BACKLOG_API_BASE=https://api.github.com
# Keep token values in the shared runtime secrets file, never in this file or Git.
# The intent-backlog repo is not available to the GitHub App:
#   INTENT_BACKLOG_READ_TOKEN: Orchestrator read-only access to frozen intents and product config.
# The intent-creation skill uses INTENT_BACKLOG_WRITE_TOKEN for backlog updates.
# Product-code repositories use GitHub App installation tokens:
#   ORCHESTRATOR_GITHUB_APP_READ_TOKEN: Orchestrator reads repository refs and artifacts.
#   SPEC_DESIGN_GITHUB_APP_WRITE_TOKEN: Spec & Design Agent creates/pushes its product branch.
#   EVALUATOR_GITHUB_APP_WRITE_TOKEN: Orchestrator publishes the Evaluation Package to that branch.
# The Spec & Design Agent receives its App token as SPEC_AGENT_GITHUB_TOKEN.
# Do not use a shared GITHUB_TOKEN fallback; provision only the role-specific values.
# INTENT_BACKLOG_READ_TOKEN=
# INTENT_BACKLOG_WRITE_TOKEN=
# ORCHESTRATOR_GITHUB_APP_READ_TOKEN=
# SPEC_DESIGN_GITHUB_APP_WRITE_TOKEN=
# EVALUATOR_GITHUB_APP_WRITE_TOKEN=

# Where the isolated per-work-item clones are created before being bind-mounted
# into the container. Defaults to a sibling of TARGET_REPO.
# SPEC_WORKSPACE_ROOT=C:/Repos/agentic-sdlc-workspaces

# Authenticated NAS Evaluator API. The evaluator receives a Git URL and commit SHA,
# then creates and deletes a request-scoped checkout inside its stateless container.
EVALUATOR_API_URL=http://10.100.10.10:8080
# Store EVALUATOR_API_TOKEN in the shared workspace runtime file instead of this repository:
# C:\Repos\.config\agentic-sdlc\runtime.env

# Repository the Coding Agent operates on. Evaluator receives the candidate
# worktree path from the Coding Agent Evidence Package.
TARGET_REPO=C:/Repos/mealflow

# Public base callback URL for the Trello webhook (Cloudflare Tunnel).
CALLBACK_URL=

PORT=8787
