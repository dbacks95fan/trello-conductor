# Trello API credentials — from https://trello.com/power-ups/admin
# TRELLO_API_KEY and TRELLO_API_SECRET are shown together on that page.
# TRELLO_TOKEN is generated from the same page (needs read+write scope, since
# Trello Conductor moves cards and posts comments).
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_API_SECRET=

# The board Trello Conductor watches. Accepts the short link from the board's
# URL (e.g. https://trello.com/b/cawKDxHQ/menu-app -> cawKDxHQ) or the full id.
TRELLO_BOARD_ID=cawKDxHQ

# List names on that board — must match exactly (case-sensitive).
TRELLO_LIST_READY=Ready for Agent
TRELLO_LIST_WORKING=Agent Working
TRELLO_LIST_REVIEW=Agent Review

# How many cards may be in TRELLO_LIST_WORKING at once. This is the WIP limit.
WIP_LIMIT=1

# Absolute path to the coding-agent tool's built entrypoint.
CODING_AGENT_CLI=C:/Repos/coding-agent/dist/cli.js
# Absolute path to the target repository the Coding Agent operates on.
TARGET_REPO=C:/Repos/menuapp

# Public callback URL for the Trello webhook (the cloudflared tunnel URL),
# e.g. https://random-words.trycloudflare.com/webhooks/trello
CALLBACK_URL=

PORT=8787
